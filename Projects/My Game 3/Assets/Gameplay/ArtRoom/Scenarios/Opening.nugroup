      [ChangeAnimation Player Reacting Idle 1 0]
      [MoveCharacter Player PlayerPosition]
      [SetCamera ConversationCamera]
      [FadeIn 1]
      [Wait 1]
      [Exposit
       "Wahh! You surprised me!"
       [PortraitDialogue [Characters AikoSurprised]]]
      [FacialExpression Aiko 5 0 0.3]
      [ChangeAnimation Aiko Reacting Idle 1 0.1]
      [Exposit
