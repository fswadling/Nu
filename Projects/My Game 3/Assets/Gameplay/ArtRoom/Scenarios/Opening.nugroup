 [[Editing True]
  [InitialCues
   [[MeetAiko
     [[StopCameraFollow Player]
      [SetCamera InitialCamera]
      [Wait 0.3]
      [ChangeAnimation Player Idle Reacting 1 0.5]
      [FadeOut 1]
      [SetCamera PanAiko]
