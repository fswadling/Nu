[ScenarioDispatcher
 [[Editing True]
  [InitialCues
   [[LibraryOpening
     [[SetCamera InitialCamera]
      [Wait 0.5]
      [Exposit "So what was he like?" Dialogue]
      [Exposit
       "He was fine, seemed a little off though... like he didn't know what was going on."
       [PortraitDialogue [Characters AkaneNeutral]]]
      [Exposit "Was he cute?" Dialogue]
      [Exposit
       "Misa! Don't ask me that!"
       [PortraitDialogue [Characters AkaneSurprised]]]
      [Exposit "Why not? oh you're no fun..." Dialogue]
      [Exposit "Is someone there?" Dialogue]
      [LocomoteCharacter Akane AkaneWalkTo 1 Idle Walk]
      [Exposit
       "Oh hi! How long have you been standing there!"
       [PortraitDialogue [Characters AkaneSurprised]]]
      [FadeOut 1]
      [MoveCharacter Akane AkanePosition2]
      [MoveCharacter Player PlayerPosition2]
      [MoveCharacter Misa MisaPosition2]
      [FacialExpression Misa 3 1 0.2]
      [SetCamera PanMisa]
      [FadeIn 1]
      [FlyCamera PanMisa 0.5]
      [Exposit
       "Hi i'm Misa! Nice to meet you!"
       [PortraitDialogue [Characters MisaHappy]]]
      [FadeOut 1]
      [SetCamera ConversationCamera]
      [FadeIn 1]
      [Exposit
       "We were just studying, we like to study in the morning before class."
       [PortraitDialogue [Characters AkaneNeutral]]]
      [Exposit
       "Yeah Akane helps me study because she's super smart,and i'm well..."
       [PortraitDialogue [Characters MisaHappy]]]
      [FacialExpression Misa 3 0 0.3]
      [FacialExpression Akane 3 1 0.3]
      [Exposit
       "Ehem, well this is the library, you can come here to study before and after class. There's books on just about evrything here."
       [PortraitDialogue [Characters AkaneHappy]]]
      [FacialExpression Akane 3 0 0.3]
      [FacialExpression Misa 3 1 0.3]
      [Exposit
       "And I hear there's a ghost that lives here."
       [PortraitDialogue [Characters MisaHappy]]]
      [FacialExpression Akane 4 1 0.3]
      [Exposit
       "Misa! don't be weird in front of the new boy, thats just a silly rumour!"
       [PortraitDialogue [Characters AkaneSad]]]
      [FacialExpression Akane 4 0 0.3]
      [Exposit
       "Anyway you should get to class, you don't want to be late!"
       [PortraitDialogue [Characters AkaneNeutral]]]
      [Advent MisaFirstMeeting]
      [SwitchToZoneAndSwapPlayer Corridors LibraryExit]]
     None]]]
