[ScenarioDispatcher
[[InitialCues
  [[Opening
    [[SetCamera OpeningStartCamera]
      [Exposit "Oh wow thais pDace has a rooftop pool!" Thought]
      [Exposit "Hey! what do you think you're doing?" Dialogue]
      [LocomoteCharacter Player FaceSakura 1 Idle Walk]
      [FacialExpression Player 21 1 0.3]
      [ChangeAnimation Player Idle Reacting 1 0.5]
      [FadeOut 1]
      [SetCamera SakuraPan]
      [FadeIn 1]
      [FlyCamera SakuraPan 0.5]
      [Wait 2]
      [FadeOut 1]
      [MoveCharacter [Sakura Swimwear] SakuraComeover]
      [SetCamera ConversationCamera]
      [FadeIn 1]
      [Exposit
       "Did you come here to peek on me in my swimsuit!? Pervert!"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit "More anime schoolgirls? Oh no this looks bad..." Thought]
      [Exposit
       "Well? What do you have to say for yourself?"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit
       "No it's not like that! I didn't know anyone was up here!"
       [PortraitDialogue [Characters PlayerSurpised]]]
      [Exposit
       "A likely story! You must be that new boy who's starting today. Why am I not surprised you're a pervert?"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit
       "Akane said to go explore before class starts! She didn't mention anyone being up here I swear! You can ask her!"
       [PortraitDialogue [Characters PlayerSurpised]]]
      [Exposit
       "Hmm, I suppose there's no reason you'd assume anyone would be practicing swimming before class."
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit
       "You'd better hope Akane can back up what you say! Because if not i'll report you to Hana-sensei!"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit
       "The name's Sakura! And don't you forget it!"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Exposit
       "Now get out of here!"
       [PortraitDialogue [Characters SakuraSwimsuitAngry]]]
      [Advent SakuraFirstMeeting]
      [SwitchToZoneAndSwapPlayer Corridors PoolExit]]
     None]]]
