[ScenarioDispatcher
[[InitialCues
  [[Opening
    [[Animation Player Reacting 1 0.1]
      [SetCamera InitialCamera]
      EnableFastForward
      [Wait 1]
      [Exposit "I'm... an anime character!" Thought]
      [Forq
       [[ChangeAnimation Player Reacting Idle 1 1]]]
      [Forq
       [[ChangeFacialExpression Player 5 21 1 1]]]
      [Exposit "A teenage anime character?!" Thought]
      [Exposit "Where on earth am I!?" Thought]
      [ChangeFacialExpression Player 21 3 1 0.3]
      [Exposit "Oh this must just be a dream..." Thought]
      [FacialExpression Player 3 0 1]
      [Exposit "Might as well explore a bit until I wake up" Thought]
      [FlyCamera CameraWaypoint 1]
      DisableFastForward
      [CameraFollow Player]
      [EnableMovement Player]
      [AwaitSignal
       [All
        [[On ComputerInteracted] [On MangaInteracted] [On HifiInteracted]]]]
      [Disable ComputerInteractable]
      [Disable MangaInteractable]
      [Disable HifiInteractable]
      [DisableMovement Player]
      [StopCameraFollow Player]
      [FadeOut 1]
      [SetCamera CameraAfterLookAround]
      [MoveCharacter Player MoveToAfterInteractions]
      [StopAllAnimations Player]
      [Animation Player Idle 1 0]
      [FadeIn 1]
      EnableFastForward
      [FacialExpression Player 10 1 0.1]
      [Exposit "Looks like an old japanese bedroom." Thought]
      [Exposit "It's a very vivid dream..." Thought]
      [FacialExpression Player 10 0 0.1]
      [FacialExpression Player 3 1 0.1]
      [Exposit "Maybe I've been watching too much anime!" Thought]
      [FacialExpression Player 3 0 0.1]
      [Exposit Hello? Dialogue]
      [FacialExpression Player 8 1 0.1]
      [Exposit "Somebody is at the door." Thought]
      [FacialExpression Player 8 0 0.1]
      [FacialExpression Player 5 1 0.1]
      [Exposit ! Thought]
      [FadeOut 1]
      [AddCharacter Akane AkaneAppear]
      [ChangeAnimation Akane Idle StandingGreeting 1 0.1]
      [SetCamera PanAkaneStart]
      [PlaySong [Music Casual1]]
      [FadeIn 1]
      [Forq
       [[FacialExpression Akane 3 1 1]]]
      [FlyCamera PanAkaneStart 0.5]
      [Forq
       [[FacialExpression Akane 3 0 0.5]]]
      [Forq
       [[Wait 3] [ChangeAnimation Akane StandingGreeting Idle 1 0.5]]]
      [FadeOut 1]
      [SetCamera ConversationCamera]
      [FadeIn 1]
      [ChangeFacialExpression Player 5 21 1 0.1]
      [Exposit
       "Hi! Nice to meet you, I'm Akane!"
       [PortraitDialogue [Characters AkaneHappy]]]
      [FacialExpression Akane 4 1 0.1]
      [Exposit
       "Er you were told that I was going to pick you up for school for your first day right?"
       [PortraitDialogue [Characters AkaneSad]]]
      [Forq
       [[Emote Player [Emotes Emote16]]]]
      [Exposit "I'm having dreams about anime schoolgirls now...." Thought]
      [Exposit "I really need to get a girlfriend..." Thought]
      [Exposit "I'll just play along for now." Thought]
      [Forq
       [[ChangeFacialExpression Player 21 3 1 0.1] [Wait 1] [FacialExpression Player 3 0 0.1]]]
      [Exposit
       "Er... yes I remember! My first day of school..."
       [PortraitDialogue [Characters PlayerHappy]]]
      [Forq
       [[ChangeFacialExpression Akane 4 3 1 0.3] [Wait 1] [FacialExpression Akane 3 0 0.3]]]
      [Exposit
       "Nervous? I guess I would be too in your position, But don't worry, I'm sure you'll fit right in!"
       [PortraitDialogue [Characters AkaneHappy]]]
      [Exposit "My position?" Thought]
      [Forq
       [[ChangeFacialExpression Akane 4 3 1 0.3] [Wait 1] [FacialExpression Akane 3 0 0.3]]]
      [Exposit
       "Anyway we don't want to be late, let's go!"
       [PortraitDialogue [Characters AkaneHappy]]]
      DisableFastForward
      [Advent ApartmentOpeningComplete]]
     None]]]
  [Editing True]
  [Model ["Microsoft.FSharp.Core.Unit, FSharp.Core, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" []]]
