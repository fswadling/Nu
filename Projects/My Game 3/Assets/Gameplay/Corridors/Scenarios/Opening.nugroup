      [FacialExpression Player 5 1 0]
      [SetCamera OpeningCamera]
      [Exposit
       "Well, Here we are!"
       [PortraitDialogue [Characters AkaneHappy]]]
      [Exposit "How did we get here so fast!?" Thought]
      [Exposit "Dream logic I suppose..." Thought]
      [ChangeFacialExpression Akane 3 4 1 0.3]
      [Exposit
       "Um, are you ok?"
       [PortraitDialogue [Characters AkaneSad]]]
      [ChangeAnimation Player Reacting Idle 1 0.5]
