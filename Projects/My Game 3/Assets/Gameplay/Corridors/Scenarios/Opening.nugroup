      [Exposit
       "Oh, it's nothing."
       [PortraitDialogue [Characters PlayerHappy]]]
      [FacialExpression Player 3 0 0.3]
      [ChangeFacialExpression Akane 4 3 1 0.3]
      [Exposit
       "Ok then! Class doesn't start for a bit so why don't you go explore?"
       [PortraitDialogue [Characters AkaneHappy]]]
      [Exposit
       "When you're ready to begin, head to the class right behind me. I'll be studying in the library."
       [PortraitDialogue [Characters AkaneHappy]]]
      [ChangeFacialExpression Akane 4 3 0 0.3]
      [LocomoteCharacter Akane AkaneWalkAway 1 Idle Walk]
      [FadeOut 1]
      [RemoveCharacter Akane]
      [CameraFollow Player]
      [FadeIn 1]
      [Enable LookOutWindow]
      [EnableMovement Player]]
     None]]]
